{
  "providers": {
    "9router": {
      "apiKey": "${NANOBOT_9ROUTER_API_KEY}",
      "apiBase": "${NANOBOT_9ROUTER_BASE_URL}",
      "extraHeaders": {
        "User-Agent": "nanobot/0.2.0"
      }
    }
  },
  "agents": {
    "defaults": {
      "provider": "${NANOBOT_PROVIDER}",
      "model": "${NANOBOT_9ROUTER_MODEL}",
      "workspace": "/home/nanobot/.nanobot/workspace",
      "unifiedSession": true,
      "maxConcurrentSubagents": 1
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_TOKEN}",
      "allowFrom": ["${TELEGRAM_ALLOW_FROM}"]
    },
    "websocket": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 8765,
      "defaultChatId": "unified:default",
      "token": "${NANOBOT_WEB_TOKEN}",
      "websocketRequiresToken": true,
      "streaming": false,
      "allowFrom": ["*"]
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "heartbeat": {
      "enabled": true
    }
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8900
  },
  "tools": {
    "restrictToWorkspace": true,
    "exec": {
      "enable": true,
      "sandbox": "bwrap",
      "pathAppend": "/home/nanobot/.local/bin:/usr/local/bin"
    },
    "web": {
      "enable": true
    },
    "imageGeneration": {
      "enabled": false
    },
    "mcpServers": {}
  }
}
