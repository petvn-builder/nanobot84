{
  "providers": {
    "9router": {
      "apiKey": "${NANOBOT_9ROUTER_API_KEY}",
      "apiBase": "${NANOBOT_9ROUTER_BASE_URL}",
      "extraHeaders": {
        "User-Agent": "nanobot/0.2.0"
      }
    }
  },
  "agents": {
    "defaults": {
      "provider": "${NANOBOT_PROVIDER}",
      "model": "${NANOBOT_9ROUTER_MODEL}",
      "workspace": "/home/nanobot/.nanobot/workspace",
      "timezone": "Asia/Ho_Chi_Minh",
      "unifiedSession": true,
      "maxConcurrentSubagents": 1
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_TOKEN}",
      "allowFrom": ["${TELEGRAM_ALLOW_FROM}"]
    },
    "websocket": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 8765,
      "defaultChatId": "unified:default",
      "token": "${NANOBOT_WEB_TOKEN}",
      "websocketRequiresToken": true,
      "streaming": false,
      "allowFrom": ["*"]
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "heartbeat": {
      "enabled": true
    }
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8900
  },
  "tools": {
    "restrictToWorkspace": true,
    "exec": {
      "enable": true,
      "sandbox": "bwrap",
      "pathAppend": "/home/nanobot/.local/bin:/usr/local/bin"
    },
    "web": {
      "enable": true
    },
    "imageGeneration": {
      "enabled": false
    },
    "mcpServers": {
      "google-calendar": {
        "command": "npx",
        "args": ["-y", "@cocal/google-calendar-mcp"],
        "env": {
          "GOOGLE_OAUTH_CREDENTIALS": "/home/nanobot/exports/google-calendar/gcp-oauth.keys.json",
          "GOOGLE_CALENDAR_MCP_TOKEN_PATH": "/home/nanobot/exports/google-calendar/tokens",
          "ENABLED_TOOLS": "list-calendars,list-events,search-events,get-event,get-freebusy,get-current-time,create-event,update-event"
        },
        "enabledTools": [
          "list-calendars",
          "list-events",
          "search-events",
          "get-event",
          "get-freebusy",
          "get-current-time",
          "create-event",
          "update-event",
          "manage-accounts"
        ],
        "toolTimeout": 120
      }
    }
  }
}
